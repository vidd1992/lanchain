# OpenAI API Key
OPENAI_API_KEY=tu-api-key-aqui
OPENAI_MODEL=gpt-4o-mini

# Pinecone Configuration
PINECONE_API_KEY=tu-pinecone-api-key
PINECONE_INDEX_NAME=tu-index-name
PINECONE_ENVIRONMENT=us-east-1

# Configuración avanzada de Pinecone (opcional)
PINECONE_DIMENSION=1536
PINECONE_METRIC=cosine
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# Perplexity API Key
PERPLEXITY_API_KEY=tu-perplexity-api-key
PERPLEXITY_MODEL=sonar
# Dominios específicos para búsqueda web (separados por comas, opcional)
# Ejemplo: PERPLEXITY_SEARCH_DOMAINS=www.cec-epn.edu.ec,cec-epn.edu.ec
PERPLEXITY_SEARCH_DOMAINS=

# Configuración del agente
RAG_SIMILARITY_THRESHOLD=0.7
RAG_TOP_K=3

# Configuración de procesamiento de documentos
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Configuración del Agente (Personalidad/Contexto)
AGENT_NAME=Asistente CEC-EPN
AGENT_ROLE=asistente virtual del Centro de Educación Continua de la Escuela Politécnica Nacional
AGENT_GREETING=¡Hola! Soy el asistente virtual del CEC-EPN. ¿En qué puedo ayudarte hoy?

# Debug y logging
# Activar modo debug para ver el flujo interno del agente
DEBUG_MODE=false
LANGCHAIN_VERBOSE=false
